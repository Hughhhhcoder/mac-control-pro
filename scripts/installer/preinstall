#!/bin/bash
set -euo pipefail
[[ "$EUID" -eq 0 ]] || { echo 'macOS Installer administrator authorization is required.' >&2; exit 1; }
[[ "${3:-/}" == / ]] || { echo 'Install on the current startup volume.' >&2; exit 1; }
. "$(/usr/bin/dirname "$0")/console-user.sh"
console_control_uid >/dev/null
SYSTEM_MAJOR="$(/usr/bin/sw_vers -productVersion | /usr/bin/cut -d . -f 1)"
[[ "$SYSTEM_MAJOR" =~ ^[0-9]+$ && "$SYSTEM_MAJOR" -ge 14 ]] || { echo 'macOS 14 or later is required.' >&2; exit 1; }
for directory in /Applications /Library/PrivilegedHelperTools /Library/LaunchDaemons; do
  [[ ! -L "$directory" ]] || { echo "Refusing symlink installation directory: $directory" >&2; exit 1; }
done
[[ ! -L '/Applications/Mac Control Pro.app' ]] || { echo 'Refusing a symlink at the application destination.' >&2; exit 1; }
